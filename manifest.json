{
  "manifest_version": 3,
  "name": "Smart TOC & Scroll",
  "version": "2.19",
  "minimum_chrome_version": "111",
  "description": "Adaptive reading navigation for long articles: TOC, progress outline, hover preview, smart skip, and smooth scroll to top.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "js": ["catalog.js", "theme.js"],
      "css": ["toc.css", "themes.css"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
